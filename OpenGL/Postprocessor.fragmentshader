#version 330

in vec2 retTexCoords;

out vec4 FragColor;

uniform sampler2D screenTexture;
uniform sampler2D depthSampler;

const float offset = 1.0 / 300.0;
float low1 = 0.8f;
float high1 = 1.0f;
float low2 = 0.0f;
float high2 = 1.0f;

void main()
{
	vec2 offsets[9] = vec2[](
        vec2(-offset,  offset), // top-left
        vec2( 0.0f,    offset), // top-center
        vec2( offset,  offset), // top-right
        vec2(-offset,  0.0f),   // center-left
        vec2( 0.0f,    0.0f),   // center-center
        vec2( offset,  0.0f),   // center-right
        vec2(-offset, -offset), // bottom-left
        vec2( 0.0f,   -offset), // bottom-center
        vec2( offset, -offset)  // bottom-right    
    );

    float kernel[9] = float[](
        1, 1, 1,
        1, -7, 1,
        1, 1, 1
    );

    // float kernel[9] = float[](
    //    1.0 / 16, 2.0 / 16, 1.0 / 16,
    //    2.0 / 16, 4.0 / 16, 2.0 / 16,
    //    1.0 / 16, 2.0 / 16, 1.0 / 16  
    // );
    
    vec3 sampleTex[9];
    for(int i = 0; i < 9; i++)
    {
        sampleTex[i] = vec3(texture(screenTexture, retTexCoords.st + offsets[i]));
    }
    /*
    vec3 col = vec3(0.0);
    for(int i = 0; i < 9; i++)
    {
        col += sampleTex[i] * kernel[i];
    }
    */

    // FragColor = vec4(col, 1.0);
	
    vec3 col = texture(screenTexture, retTexCoords).rgb;
	// FragColor = vec4(vec3(1.0 - col), 1.0);

	float average = 0.2126 * col.r + 0.7152 * col.g + 0.0722 * col.b;
	// FragColor = vec4(average, average, average, 1.0);
    
    float depthValue = texture(depthSampler, retTexCoords.st).r;
    float remappedValue = low2 + (depthValue - low1) * ((high2 - low2) / (high1 - low1));
    FragColor = vec4(remappedValue * average, remappedValue * average, remappedValue * average, 1.0);
}
